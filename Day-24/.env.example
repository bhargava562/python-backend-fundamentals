# ============================================
# Environment Configuration Template
# Copy this file to .env and update values
# ============================================

# Application Environment
ENV=production
PROJECT_NAME="Zenovox Production System"
VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres_user:secure_prod_password@db:5432/zenovox_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Security
SECRET_KEY=generate_a_high_entropy_sha256_hash_here_for_jwt_signing

# CORS and Allowed Hosts
ALLOWED_HOSTS=api.zenovox.com,localhost,127.0.0.1

# Rate Limiting
RATE_LIMIT_RULE="100 per minute"

# Database Connection Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. Generate SECRET_KEY with: openssl rand -hex 32
# 2. Never commit .env file to version control
# 3. Use different values for development/staging/production
# 4. Ensure DATABASE_URL includes proper authentication
# 5. Update ALLOWED_HOSTS in production environment
# 6. Keep sensitive values in secrets management system
