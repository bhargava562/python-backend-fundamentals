# ============================================
# Environment Configuration Template
# Copy this file to .env and update values
# ============================================

# Application Environment
# For local Docker Compose: use "development"
# For production: use "production"
ENV=development

PROJECT_NAME="Zenovox System"
VERSION=1.0.0

# ============================================
# DATABASE CONFIGURATION
# ============================================
# LOCAL DEVELOPMENT (with docker-compose):
# DATABASE_URL=postgresql+asyncpg://postgres_user:postgres_password@localhost:5432/zenovox_db
#
# PRODUCTION (cloud/remote):
# DATABASE_URL=postgresql+asyncpg://user:secure_password@prod-db-host:5432/zenovox_db
DATABASE_URL=postgresql+asyncpg://postgres_user:postgres_password@localhost:5432/zenovox_db

# ============================================
# REDIS CONFIGURATION
# ============================================
# LOCAL DEVELOPMENT: localhost:6379
# PRODUCTION: redis.example.com:6379 or managed redis service
REDIS_URL=redis://localhost:6379/0

# ============================================
# CELERY CONFIGURATION
# ============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# SECURITY
# ============================================
# Generate with: openssl rand -hex 32
# MUST be changed for production!
SECRET_KEY=dev-secret-key-change-in-production-12345678

# ============================================
# CORS and Hosting
# ============================================
# LOCAL: "*"
# PRODUCTION: "api.example.com,www.example.com"
ALLOWED_HOSTS=*

# ============================================
# RATE LIMITING
# ============================================
# LOCAL: "1000 per minute" (relaxed for development)
# PRODUCTION: "100 per minute" (stricter)
RATE_LIMIT_RULE="1000 per minute"

# ============================================
# Database Connection Pooling
# ============================================
# These values are optimized for development
# Adjust for production based on traffic
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. LOCAL DEVELOPMENT (docker-compose):
#    - User: postgres_user
#    - Password: postgres_password
#    - DB: zenovox_db
#    - Matches docker-compose.yml PostgreSQL service
#
# 2. PRODUCTION:
#    - Update DATABASE_URL with production credentials
#    - Generate new SECRET_KEY: openssl rand -hex 32
#    - Update ALLOWED_HOSTS to your domain
#    - Update RATE_LIMIT_RULE for production traffic
#    - Set ENV=production
#
# 3. Security:
#    - Never commit .env to version control
#    - Use secrets manager (AWS Secrets, HashiCorp Vault) in production
#    - Rotate credentials regularly
#
# 4. Testing:
#    - Verify DATABASE_URL connects: psql -d postgresql://...
#    - Verify REDIS_URL connects: redis-cli -u redis://...

