# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env with real credentials to git!
# .env is already in .gitignore to prevent accidental commits
# ============================================================================

# Database Configuration
# For PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/database_name
# Note: Special characters in password must be URL-encoded (e.g., @ = %40)
# 
# For SQLite (local development):
# DATABASE_URL=sqlite:///./ecommerce.db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/fastapi_demo

# Security Configuration
# Generate a secure secret key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_super_secret_key_change_in_production

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# Security Best Practices:
# ============================================================================
# 1. Never hardcode real passwords - use environment variables
# 2. Generate strong random secrets for production
# 3. Keep .env out of version control (already configured in .gitignore)
# 4. Use a secrets management system in production:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Azure Key Vault
#    - Google Cloud Secret Manager
# 5. Rotate credentials regularly
# 6. Use different credentials for dev/staging/production
# ============================================================================

